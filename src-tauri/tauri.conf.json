{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DisyLab",
  "version": "2.0.3",
  "identifier": "com.disylab.canvas",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "DisyLab Canvas",
        "theme": "Dark",
        "decorations": false,
        "shadow": false,
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 560,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: https: http:; media-src 'self' blob: data: https: http:; connect-src 'self' blob: data: ipc: http://ipc.localhost https://ipc.localhost https: http:; worker-src 'self' blob:; frame-src 'none'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../public/favicon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true
      }
    }
  }
}
