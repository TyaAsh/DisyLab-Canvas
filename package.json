{
  "name": "disy-infinite-canvas",
  "private": true,
  "version": "1.0.5",
  "license": "UNLICENSED",
  "author": "DisyLab",
  "homepage": "https://tyaash.github.io/DisyLab-Canvas/",
  "repository": {
    "type": "git",
    "url": "https://github.com/TyaAsh/DisyLab-Canvas.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.8.0"
  },
  "scripts": {
    "dev": "vite --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "npm run test:providers && npm run test:relay && npm run check:prompt-library && npm run audit:workflows",
    "test:relay": "node --test functions/relay.test.mjs",
    "test:providers": "node --test src/providerLifecycle.test.mjs src/imageApi.test.mjs src/nodeReferences.test.mjs src/storyboard.test.mjs",
    "check:prompt-library": "node scripts/check-prompt-library-integrity.mjs",
    "audit:workflows": "node scripts/audit-workflow-duplicates.mjs",
    "import:local-library": "node scripts/import-local-reference-library.mjs && node scripts/rewrite-local-prompts.mjs",
    "build:render-library": "node scripts/extend-render-reference-library.mjs",
    "build:fintech-library": "node scripts/build-fintech-visual-library.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@huggingface/transformers": "^4.2.0",
    "@xyflow/react": "^12.6.0",
    "framer-motion": "^12.40.0",
    "gsap": "^3.15.0",
    "handlebars": "^4.7.9",
    "idb": "^8.0.3",
    "lucide-react": "^0.546.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "three": "^0.185.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@rolldown/binding-win32-x64-msvc": "^1.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "wrangler": "^4.129.1"
  }
}
